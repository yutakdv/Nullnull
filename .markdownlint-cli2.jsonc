{
  "config": {
    "MD013": false
  },
  "ignores": [
    "**/node_modules/**"
  ],
  "globs": [
    "README.md",
    "AGENTS.md",
    "CLAUDE.md",
    "apps/*/CLAUDE.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "docs/archive/PRODUCT_BRIEF.md",
    ".claude/**/*.md",
    ".github/**/*.md",
    "docs/README.md",
    "docs/api/**/*.md",
    "docs/architecture/**/*.md",
    "docs/contest/**/*.md",
    "docs/contracts/**/*.md",
    "docs/data/**/*.md",
    "docs/decisions/**/*.md",
    "docs/design/**/*.md",
    "docs/engineering/**/*.md",
    "docs/operations/**/*.md",
    "docs/product/**/*.md",
    "docs/project/**/*.md",
    "docs/roles/**/*.md",
    "docs/security/**/*.md"
  ]
}
