{
  "config": {
    "MD013": false
  },
  "ignores": [
    "**/node_modules/**",
    "HANDOFF-PROMPT.md",
    "NIGHT_WORK_REPORT.md"
  ],
  "globs": [
    "README.md",
    "AGENTS.md",
    "CLAUDE.md",
    "apps/*/CLAUDE.md",
    "apps/*/README.md",
    "packages/*/README.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "docs/archive/PRODUCT_BRIEF.md",
    ".claude/**/*.md",
    ".github/**/*.md",
    "docs/**/*.md"
  ]
}
