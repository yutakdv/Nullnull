{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OwnCdkToolkitStack",
      "Effect": "Allow",
      "Action": "cloudformation:*",
      "Resource": [
        "arn:aws:cloudformation:ap-northeast-2:${Account}:stack/NullnullStgCDKToolkit/*",
        "arn:aws:cloudformation:us-east-1:${Account}:stack/NullnullStgCDKToolkit/*"
      ]
    },
    {
      "Sid": "ReadNullnullStacks",
      "Effect": "Allow",
      "Action": [
        "cloudformation:DescribeStacks",
        "cloudformation:GetTemplate",
        "cloudformation:DescribeStackEvents",
        "cloudformation:DescribeStackResources",
        "cloudformation:ListStackResources",
        "cloudformation:GetTemplateSummary"
      ],
      "Resource": [
        "arn:aws:cloudformation:ap-northeast-2:${Account}:stack/NullnullStg*/*",
        "arn:aws:cloudformation:us-east-1:${Account}:stack/NullnullStg*/*"
      ]
    },
    {
      "Sid": "CdkBootstrapRoles",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:GetRole",
        "iam:UpdateRole",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:GetRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:DetachRolePolicy",
        "iam:UpdateAssumeRolePolicy",
        "iam:ListRoleTags"
      ],
      "Resource": "arn:aws:iam::${Account}:role/cdk-nnstg-*"
    },
    {
      "Sid": "CdkBootstrapManagedPoliciesOnly",
      "Effect": "Allow",
      "Action": "iam:AttachRolePolicy",
      "Resource": "arn:aws:iam::${Account}:role/cdk-nnstg-*",
      "Condition": {
        "ArnEquals": {
          "iam:PolicyARN": [
            "arn:aws:iam::aws:policy/ReadOnlyAccess",
            "arn:aws:iam::aws:policy/AWSCloudFormationReadOnlyAccess",
            "arn:aws:iam::${Account}:policy/NullnullStgCfnExecution",
            "arn:aws:iam::${Account}:policy/NullnullStgCfnExecutionNetworkGuards",
            "arn:aws:iam::${Account}:policy/NullnullStgCfnExecutionServiceGuards"
          ]
        }
      }
    },
    {
      "Sid": "CdkBootstrapStorage",
      "Effect": "Allow",
      "Action": [
        "s3:*",
        "ecr:*"
      ],
      "Resource": [
        "arn:aws:s3:::cdk-nnstg-assets-${Account}-*",
        "arn:aws:s3:::cdk-nnstg-assets-${Account}-*/*",
        "arn:aws:ecr:*:${Account}:repository/cdk-nnstg-container-assets-*"
      ]
    },
    {
      "Sid": "CdkBootstrapVersionParameter",
      "Effect": "Allow",
      "Action": [
        "ssm:PutParameter",
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:DeleteParameter",
        "ssm:AddTagsToResource",
        "ssm:RemoveTagsFromResource",
        "ssm:ListTagsForResource"
      ],
      "Resource": "arn:aws:ssm:*:${Account}:parameter/cdk-bootstrap/nnstg/*"
    },
    {
      "Sid": "DeployThroughCdkRoles",
      "Effect": "Allow",
      "Action": "sts:AssumeRole",
      "Resource": "arn:aws:iam::${Account}:role/cdk-nnstg-*"
    },
    {
      "Sid": "DeploymentLock",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:DeleteItem"
      ],
      "Resource": "arn:aws:dynamodb:ap-northeast-2:${Account}:table/nullnull-stg-deployment-lock"
    },
    {
      "Sid": "RunMigrationAndOpsTasks",
      "Effect": "Allow",
      "Action": "ecs:RunTask",
      "Resource": [
        "arn:aws:ecs:ap-northeast-2:${Account}:task-definition/nullnull-stg-migration:*",
        "arn:aws:ecs:ap-northeast-2:${Account}:task-definition/nullnull-stg-ops:*"
      ],
      "Condition": {
        "ArnEquals": {
          "ecs:cluster": "arn:aws:ecs:ap-northeast-2:${Account}:cluster/nullnull-stg"
        }
      }
    },
    {
      "Sid": "ObserveTasks",
      "Effect": "Allow",
      "Action": [
        "ecs:DescribeTasks",
        "ecs:ListTasks",
        "ecs:DescribeServices",
        "ecs:DescribeClusters",
        "ecs:ListServices"
      ],
      "Resource": [
        "arn:aws:ecs:ap-northeast-2:${Account}:task/nullnull-stg/*",
        "arn:aws:ecs:ap-northeast-2:${Account}:container-instance/nullnull-stg/*",
        "arn:aws:ecs:ap-northeast-2:${Account}:service/nullnull-stg/*",
        "arn:aws:ecs:ap-northeast-2:${Account}:cluster/nullnull-stg"
      ]
    },
    {
      "Sid": "PassTaskRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::${Account}:role/NullnullStgMigration-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      }
    },
    {
      "Sid": "PublishReleaseImages",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage",
        "ecr:BatchGetImage",
        "ecr:DescribeImages",
        "ecr:GetDownloadUrlForLayer",
        "ecr:ListImages"
      ],
      "Resource": "arn:aws:ecr:ap-northeast-2:${Account}:repository/nullnull-stg-*"
    },
    {
      "Sid": "ReleaseRecords",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::nullnullstgfoundation-releases*",
        "arn:aws:s3:::nullnullstgfoundation-releases*/*"
      ]
    },
    {
      "Sid": "SmokeReadsOfEdgeBucket",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketPublicAccessBlock",
        "s3:GetBucketPolicyStatus"
      ],
      "Resource": "arn:aws:s3:::nullnullstgwebedge-*"
    },
    {
      "Sid": "OperatorSecrets",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:PutSecretValue",
        "secretsmanager:DescribeSecret"
      ],
      "Resource": [
        "arn:aws:secretsmanager:ap-northeast-2:${Account}:secret:nullnull-stg/kto-service-key-*",
        "arn:aws:secretsmanager:ap-northeast-2:${Account}:secret:nullnull-stg/verifier-token-*",
        "arn:aws:secretsmanager:ap-northeast-2:${Account}:secret:nullnull-stg/seoul-proxy-*"
      ]
    },
    {
      "Sid": "OperatorLogs",
      "Effect": "Allow",
      "Action": [
        "logs:GetLogEvents",
        "logs:FilterLogEvents",
        "logs:DescribeLogStreams"
      ],
      "Resource": [
        "arn:aws:logs:ap-northeast-2:${Account}:log-group:NullnullStg*",
        "arn:aws:logs:ap-northeast-2:${Account}:log-group:NullnullStg*:*"
      ]
    },
    {
      "Sid": "AlarmTopicContacts",
      "Effect": "Allow",
      "Action": [
        "sns:ListSubscriptionsByTopic",
        "sns:Publish"
      ],
      "Resource": "arn:aws:sns:ap-northeast-2:${Account}:NullnullStgObservability-*"
    },
    {
      "Sid": "AlarmTopicEmailSubscriptions",
      "Effect": "Allow",
      "Action": "sns:Subscribe",
      "Resource": "arn:aws:sns:ap-northeast-2:${Account}:NullnullStgObservability-*",
      "Condition": {
        "StringEquals": {
          "sns:Protocol": "email"
        }
      }
    },
    {
      "Sid": "ReadOnlyVerification",
      "Effect": "Allow",
      "Action": [
        "ec2:Describe*",
        "elasticloadbalancing:Describe*",
        "ecs:DescribeTaskDefinition",
        "ecr:GetAuthorizationToken",
        "rds:DescribeDBInstances",
        "rds:DescribeOrderableDBInstanceOptions",
        "rds:DescribeDBEngineVersions",
        "cloudfront:GetDistribution",
        "cloudfront:GetFunction",
        "cloudfront:DescribeFunction",
        "cloudfront:TestFunction",
        "cloudfront:ListDistributions",
        "wafv2:GetWebACL",
        "cloudwatch:DescribeAlarms",
        "cloudwatch:GetMetricData",
        "pricing:GetProducts",
        "servicequotas:GetServiceQuota",
        "servicequotas:ListServiceQuotas",
        "iam:GetRole",
        "iam:GetOpenIDConnectProvider",
        "tag:GetResources"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadOwnManagedPolicies",
      "Effect": "Allow",
      "Action": [
        "iam:GetPolicy",
        "iam:GetPolicyVersion"
      ],
      "Resource": "arn:aws:iam::${Account}:policy/NullnullStg*"
    }
  ]
}
