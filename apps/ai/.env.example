# Recommendation service configuration. THIS FILE IS A LIST OF NAMES, NOT A TEMPLATE TO COPY.
#
# apps/ai reads no .env file at all. settings.py binds through pydantic-settings with no `env_file`,
# so every value arrives as a process ENVIRONMENT VARIABLE: `environment:` in
# compose.integration.yml, the task definition in staging, and locally whatever the shell exports
# (`set -a; source <file>; set +a`, the route apps/api/.env.example already describes).
#
# The header here used to say "copy to .env.local". That works for apps/api, which wrote a loader
# for it (KtoSmokeEnvironment.load reads the file by path); nothing in apps/ai ever did. An
# operator following it here would set a key that never loads, which is why the sentence is gone.
#
# The file exists so scripts/check_env_example_parity.py can compare these names against what the
# source actually binds. A name declared here that nothing reads needs a row in
# scripts/env-example-allow.txt with a reason, and the card that adds the reader DELETES that row.
# Keys stay blank here.
NULLNULL_ENV=local
NULLNULL_AI_BIND_HOST=127.0.0.1
NULLNULL_AI_PORT=8090
NULLNULL_CATALOG_VERSION=catalog-unversioned
# P0 default: no LLM provider. OPENAI is added by the P1 contract (BA-084) with a model id, timeout
# and kill switch; until AI_PROVIDER names it, the two names below are unread and carry an
# `awaiting BA-084` row in scripts/env-example-allow.txt.
AI_PROVIDER=NONE
AI_API_KEY=
AI_MODEL_ID=
