# Recommendation service configuration example. Copy to .env.local (gitignored). Keys stay blank here.
NULLNULL_ENV=local
NULLNULL_AI_BIND_HOST=127.0.0.1
NULLNULL_AI_PORT=8090
NULLNULL_CATALOG_VERSION=catalog-unversioned
# P0 default: no LLM provider. OPENAI is added by the P1 contract (BA-084) with a model id, timeout and kill switch.
AI_PROVIDER=NONE
AI_API_KEY=
AI_MODEL_ID=
