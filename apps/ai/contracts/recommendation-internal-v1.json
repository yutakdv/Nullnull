      "SlotEvaluateRequest": {
        "additionalProperties": false,
        "description": "Facts for one ACTIVE candidate: the trip dates, what already sits on them, and this place's duplicates.\n\nA trip spans at most 30 dates (§4.1), so `openingHours` and `datesWithSamePlace` are bounded by\nthe same number; a longer trip is answered for its first `candidateCaps.slotDates` dates.",
        "properties": {
          "candidateId": {
            "format": "uuid",
            "title": "Candidateid",
            "type": "string"
          },
          "checking": {
            "title": "Checking",
            "type": "boolean"
          },
          "datesWithSamePlace": {
            "items": {
              "format": "date",
              "type": "string"
            },
            "maxItems": 30,
            "title": "Dateswithsameplace",
            "type": "array"
          },
          "durationMinutes": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Durationminutes"
          },
          "evaluatedAt": {
            "format": "date-time",
            "title": "Evaluatedat",
            "type": "string"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/NeighbourItemIn"
            },
            "maxItems": 100,
            "title": "Items",
            "type": "array"
          },
          "maxItemsPerDay": {
            "minimum": 1.0,
            "title": "Maxitemsperday",
            "type": "integer"
          },
          "openingHours": {
            "additionalProperties": {
              "$ref": "#/components/schemas/OpeningWindowIn"
            },
            "maxProperties": 30,
            "propertyNames": {
              "format": "date"
            },
            "title": "Openinghours",
            "type": "object"
          },
          "placeId": {
            "format": "uuid",
            "title": "Placeid",
            "type": "string"
          },
          "routeEvidence": {
            "enum": [
              "NONE",
              "VERIFIED"
            ],
            "title": "Routeevidence",
            "type": "string"
          },
          "tripEnd": {
            "format": "date",
            "title": "Tripend",
            "type": "string"
          },
          "tripId": {
            "format": "uuid",
            "title": "Tripid",
            "type": "string"
          },
          "tripStart": {
            "format": "date",
            "title": "Tripstart",
            "type": "string"
          },
          "tripZone": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Tripzone",
            "type": "string"
          }
        },
        "required": [
          "evaluatedAt",
          "tripId",
          "candidateId",
          "placeId",
          "tripStart",
          "tripEnd",
          "tripZone",
          "durationMinutes",
          "items",
          "openingHours",
          "datesWithSamePlace",
          "routeEvidence",
          "maxItemsPerDay",
          "checking"
        ],
        "title": "SlotEvaluateRequest",
        "type": "object"
      },
      "SlotEvaluateResponse": {
        "additionalProperties": false,
        "properties": {
          "pipelineVersion": {
            "title": "Pipelineversion",
            "type": "string"
          },
          "policyHash": {
            "title": "Policyhash",
            "type": "string"
          },
          "policyVersion": {
            "title": "Policyversion",
            "type": "string"
          },
          "reasons": {
            "items": {
              "type": "string"
            },
            "title": "Reasons",
            "type": "array"
