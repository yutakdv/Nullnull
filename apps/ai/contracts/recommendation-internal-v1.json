            "anyOf": [
              {
                "format": "time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Starttime"
          }
        },
        "required": [
          "rank",
          "date",
          "startTime",
          "beforeInstant",
          "afterInstant",
          "score",
          "improvement",
          "relief",
          "changeCost",
          "beforeSnapshotId",
          "afterSnapshotId",
          "lockChecks"
        ],
        "title": "ItemProposalOut",
        "type": "object"
      },
      "ItemProposeRequest": {
