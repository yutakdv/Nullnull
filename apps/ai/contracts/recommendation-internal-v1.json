      "TemporalCandidateIn": {
        "additionalProperties": false,
        "description": "A before/after snapshot pair for the same place, already judged comparable by Spring.",
        "properties": {
          "afterSnapshotId": {
            "format": "uuid",
            "title": "Aftersnapshotid",
            "type": "string"
          },
          "afterValue": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "title": "Aftervalue"
          },
          "beforeSnapshotId": {
            "format": "uuid",
            "title": "Beforesnapshotid",
            "type": "string"
          },
          "beforeValue": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "title": "Beforevalue"
          },
          "date": {
            "format": "date",
            "title": "Date",
            "type": "string"
          },
          "metricCode": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Metriccode",
            "type": "string"
          },
          "placeId": {
            "format": "uuid",
            "title": "Placeid",
            "type": "string"
          },
          "resolution": {
            "enum": [
              "DAY",
              "HOUR"
            ],
            "title": "Resolution",
            "type": "string"
          },
          "time": {
            "anyOf": [
              {
                "format": "time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Time"
          },
          "verdictEligible": {
            "title": "Verdicteligible",
            "type": "boolean"
