{
  "name": "@nullnull/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "tokens:build": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/build-tokens.mjs && git diff --exit-code -- src/design/tokens.css",
    "preview": "node serve.mjs",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:integration": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "verify:ci": "npm run tokens:check && npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@nullnull/api-client": "*",
    "@nullnull/contracts": "*",
    "@tanstack/react-query": "5.90.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router": "7.9.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.56.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/js-yaml": "4.0.9",
    "@types/node": "24.13.3",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "5.0.4",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.10.0",
    "js-yaml": "4.3.1",
    "jsdom": "27.0.0",
    "msw": "2.11.5",
    "prettier": "3.6.2",
    "storybook": "10.6.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vite": "7.1.9",
    "vitest": "3.2.4"
  }
}
