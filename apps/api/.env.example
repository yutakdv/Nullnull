# Local API configuration example. Copy to .env.local (gitignored) and fill values.
# Real provider keys never go into Git, fixtures, logs, or prompts.
NULLNULL_ENV=local
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
APP_PUBLIC_ORIGIN=http://localhost:5173
# Local PostgreSQL from the root compose.yml (host port 5433). Values are local-only.
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5433/nullnull_local
SPRING_DATASOURCE_USERNAME=nullnull
SPRING_DATASOURCE_PASSWORD=
# External sources stay mock/replay until D-003 approval. Keys stay blank here.
KTO_SERVICE_KEY=
KTO_BASE_URL=
SEOUL_API_KEY=
SEOUL_BASE_URL=
# Recommendation service (apps/ai). The local profile already points at the loopback address;
# the integration and cloud profiles require this variable and never a public host.
NULLNULL_AI_BASE_URL=http://127.0.0.1:8090
AI_PROVIDER=NONE
AI_API_KEY=

# BA-010: fill explicitly when overriding the documented defaults. Secure=false is local-only.
APP_COOKIE_SECURE=
APP_COOKIE_DOMAIN=
APP_SESSION_TTL=
APP_SESSION_ABSOLUTE_TTL=
APP_CSRF_TOKEN_TTL=
NULLNULL_JOB_RETENTION_SWEEP_INTERVAL=
