# Local API configuration example. Copy to .env.local (gitignored) and fill values.
# Real provider keys never go into Git, fixtures, logs, or prompts.
NULLNULL_ENV=local
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
APP_PUBLIC_ORIGIN=http://localhost:5173
# Local PostgreSQL from the root compose.yml (host port 5433). Values are local-only.
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5433/nullnull_local
SPRING_DATASOURCE_USERNAME=nullnull
SPRING_DATASOURCE_PASSWORD=local-only
# External provider credentials stay blank here. C2 permits only KTO KorService2/detailCommon2.
# KTO_SERVICE_KEY must be the data.go.kr decoding key; never put it in Git, fixtures, logs, or prompts.
KTO_SERVICE_KEY=
KTO_BASE_URL=
KTO_MOBILE_APP=Nullnull
KTO_MOBILE_OS=ETC
APP_RELEASE_VERSION=local-unreleased
APP_CONTEST_PROFILE=NONE
SEOUL_API_KEY=
SEOUL_BASE_URL=
# These non-secret defaults are repeated so a copied local file has the same bounded transport
# behaviour as application.yaml. Production hosts are pinned again by ProviderHostPolicy.
KTO_ALLOWED_HOST=apis.data.go.kr
SEOUL_ALLOWED_HOST=openapi.seoul.go.kr
NULLNULL_PROVIDER_CONNECT_TIMEOUT=PT2S
NULLNULL_PROVIDER_REQUEST_TIMEOUT=PT5S
NULLNULL_PROVIDER_MAX_RESPONSE_BYTES=2097152
NULLNULL_PROVIDER_EXECUTOR_THREADS=8
NULLNULL_PROVIDER_EXECUTOR_QUEUE_CAPACITY=32
NULLNULL_PROVIDER_PER_SOURCE_CONCURRENCY=4
NULLNULL_PROVIDER_RETRY_ATTEMPTS=3
NULLNULL_PROVIDER_RETRY_BASE_DELAY=PT0.1S
NULLNULL_PROVIDER_RETRY_MAX_DELAY=PT2S
NULLNULL_PROVIDER_CIRCUIT_FAILURE_THRESHOLD=5
NULLNULL_PROVIDER_CIRCUIT_FAILURE_WINDOW=PT30S
NULLNULL_PROVIDER_CIRCUIT_OPEN_DURATION=PT60S
# Recommendation service (apps/ai). The local profile already points at the loopback address;
# the integration and cloud profiles require this variable and never a public host.
NULLNULL_AI_BASE_URL=http://127.0.0.1:8090
AI_PROVIDER=NONE
AI_API_KEY=

# BA-010: fill explicitly when overriding the documented defaults. Secure=false is local-only.
APP_COOKIE_SECURE=
APP_COOKIE_DOMAIN=
APP_SESSION_TTL=
APP_SESSION_ABSOLUTE_TTL=
APP_CSRF_TOKEN_TTL=
NULLNULL_JOB_RETENTION_SWEEP_INTERVAL=
APP_DELETION_STATUS_TOKEN_TTL=
APP_DELETION_TOMBSTONE_RETENTION=
APP_DELETION_RETRY_LIMIT=
NULLNULL_DELETION_TOKEN_SECRET=
